# =========================================================
# PERFUMA ANGOLA — ENVIRONMENT VARIABLES
# =========================================================
# Copy to .env.local for local Vercel development. NEVER commit the real key.

# Public production URL, for example: https://perfuma-angola.vercel.app
VITE_SITE_URL=

# Secret key used only by api/chat.ts on the server.
GROQ_API_KEY=

# Optional model override. Current default in the code:
GROQ_MODEL=openai/gpt-oss-20b
